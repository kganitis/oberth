{
  "name": "oberth",
  "version": "1.0.0",
  "description": "A local console for every project on your Mac: start and stop dev servers, see what is running and what needs you, and pick work back up. Made to be customized by your own coding agent.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "test": "node --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "start": "node service/main.ts",
    "demo": "node scripts/demo.ts",
    "install-agent": "bash scripts/install.sh",
    "scrub-check": "bash scripts/scrub-check.sh"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
